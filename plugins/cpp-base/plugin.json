{
  "$schema": "../../schemas/plugin.schema.json",
  "id": "cpp-base",
  "name": "C/C++ Base",
  "nameZh": "C/C++ 基础",
  "version": "0.2.0",
  "publisher": "lightcpp",
  "kind": "plugin",
  "layer": "core",
  "description": "整个 C/C++ 插件生态的最底层强依赖：语法高亮、基础编译器支持（libclang / gcc / llvm / msvc 含 clang-cl）；仅当安装调试器插件时提供调试底层能力。",
  "capabilitySets": [
    "lang.cpp"
  ],
  "activation": [
    "onLanguage:cpp",
    "onLanguage:c"
  ],
  "contributes": {
    "compilers": [
      {
        "id": "libclang",
        "label": "libclang",
        "kind": "library"
      },
      {
        "id": "gcc",
        "label": "GCC",
        "kind": "toolchain"
      },
      {
        "id": "llvm",
        "label": "LLVM / Clang",
        "kind": "toolchain"
      },
      {
        "id": "msvc",
        "label": "MSVC",
        "kind": "toolchain",
        "variants": [
          "clang-cl"
        ]
      }
    ],
    "languages": [
      {
        "id": "cpp",
        "extensions": [
          ".cpp",
          ".cc",
          ".cxx",
          ".hpp",
          ".hh",
          ".hxx",
          ".h"
        ]
      },
      {
        "id": "c",
        "extensions": [
          ".c"
        ]
      }
    ],
    "debugSupport": {
      "provider": "cpp-base",
      "requiresDebuggerPlugin": true
    }
  }
}
