{
  "$schema": "../../schemas/plugin.schema.json",
  "id": "git",
  "name": "Git",
  "nameZh": "Git",
  "version": "0.1.0",
  "publisher": "lightcpp",
  "kind": "plugin",
  "layer": "tooling",
  "description": "完整的 Git 集成：克隆/打开仓库、分支与历史、合并与变基、冲突解决、子模块与 worktree、签名与认证。",
