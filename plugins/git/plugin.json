    "git.core",
    "git.history",
    "git.advanced",
    "git.ui",
    "git.auth"
  ],
  "activation": [
    "workspaceContains:.git"
  ],
  "contributes": {
    "scm": {
      "id": "git",
      "label": "Git"
    }
  }
}
