# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
build/
/Build/
/build-*/
build/*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
Testing/
/Testing/
.cache/
/.cache/

# CMake re-generates these; committing them only creates merge noise.
Makefile
compile_commands.json

# ---------------------------------------------------------------------------
# Third-party sources
# ---------------------------------------------------------------------------
# GoogleTest is vendored *and committed* so configure works offline.
# Lua and LuaBridge3 are fetched by _fetch_deps.cmake and must not be committed
# (a 3 MiB source dump in every diff buries the review).
third_party/*
!third_party/googletest-1.14.0/
!third_party/googletest-1.14.0/**

# ---------------------------------------------------------------------------
# Local tool artifacts
# ---------------------------------------------------------------------------
*.user
.vs/
.vscode/
.idea/
.workbuddy/

# Local temp files used for build/test output capture
_*.txt
_*.py
_*.cpp
_*.exe
_check.txt

# Local scratch / runtime dirs
_scratch*/
_smk*/
_sdlg*/
_enc_smoke_dir/
config/

# Coverage artifacts
coverage.info
coverage_html/

# Python (tools/lightcpp_pm.py, tests/test_pm.py)
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

