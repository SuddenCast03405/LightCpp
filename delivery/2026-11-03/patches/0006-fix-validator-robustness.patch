+    def test_dependencies_as_list_does_not_crash(self):
+        repo = make_repo(self.tmp, {"a": {}, "b": {"dependencies": ["a"]}})
+        problems = pm.validate(repo)          # 修复前抛 AttributeError
+        self.assertIn("E001", codes(problems))
