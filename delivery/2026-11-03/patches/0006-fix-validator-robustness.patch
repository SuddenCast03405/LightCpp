+    def test_duplicate_set_id(self):
+        repo = make_repo(self.tmp, {"a": {"capabilitySets": ["s"]}}, sets=[
+            {"id": "s", "domain": "tool", "label": "集", "plugins": ["a"],
+             "features": [{"id": "f1", "label": "功能"}]},
+            {"id": "s", "domain": "tool", "label": "集2", "plugins": ["a"],
